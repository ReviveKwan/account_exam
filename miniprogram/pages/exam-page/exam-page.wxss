.page {
  height: 100vh;
  background: var(--screen-bg);
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar.indigo {
  background: var(--primary);
  color: #fff;
  flex-shrink: 0;
}

.status-bar-placeholder { height: 88rpx; }

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
}

.nav-back { width: 160rpx; font-size: 28rpx; }
.nav-center { flex: 1; text-align: center; }
.nav-title { font-size: 32rpx; font-weight: 600; display: block; }
.nav-sub { font-size: 20rpx; color: rgba(224, 231, 255, 0.88); }

.nav-capsule {
  width: 160rpx; height: 58rpx; border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: space-evenly;
}
.cap-dots { display: flex; align-items: center; gap: 5rpx; }
.cap-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #fff; opacity: 0.9; }
.cap-dot.big { width: 9rpx; height: 9rpx; opacity: 1; }
.cap-divider { width: 2rpx; height: 28rpx; background: rgba(255, 255, 255, 0.24); }
.cap-circle { width: 28rpx; height: 28rpx; border-radius: 50%; border: 3rpx solid #fff; display: flex; align-items: center; justify-content: center; }
.cap-inner { width: 9rpx; height: 9rpx; border-radius: 50%; background: #fff; }

/* 计时器 */
.timer-strip {
  background: #fff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #E2E8F0;
  flex-shrink: 0;
}

.timer-top { display: flex; align-items: center; justify-content: space-between; }

.clock-pill {
  display: inline-flex; align-items: center; gap: 10rpx;
  background: var(--primary-soft); color: var(--primary);
  padding: 8rpx 20rpx; border-radius: 999rpx;
  font-size: 26rpx; font-weight: 800;
}
.clock-pill.urgent { background: var(--rose-soft); color: var(--rose); }

.timer-right { display: flex; align-items: center; gap: 16rpx; }
.font-btn {
  font-size: 22rpx; font-weight: 700; padding: 6rpx 16rpx;
  border-radius: 14rpx; background: #F8FAFC; border: 1rpx solid #E2E8F0; color: #475569;
}
.prog-text { font-size: 24rpx; color: #64748B; }
.prog-current { font-size: 28rpx; color: var(--primary); font-weight: 700; }

.prog-track { width: 100%; height: 8rpx; background: #F1F5F9; border-radius: 999rpx; margin-top: 16rpx; overflow: hidden; }
.prog-fill { height: 100%; background: var(--primary); border-radius: 999rpx; transition: width 0.2s; }

/* 题目区域 */
.scroll-area {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}
.scroll-inner {
  padding: 28rpx 32rpx 176rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.scroll-area.large-font .stem-card { font-size: 34rpx; }
.scroll-area.large-font .opt-txt { font-size: 32rpx; }

.q-meta-row { display: flex; align-items: center; justify-content: space-between; }
.q-meta-left { display: flex; gap: 12rpx; align-items: center; }
.q-badge {
  color: #fff; font-size: 22rpx; font-weight: 700;
  padding: 6rpx 18rpx; border-radius: 12rpx;
}
.q-badge.multi { background: var(--emerald); }
.q-badge.single { background: var(--primary); }
.q-year {
  background: #E2E8F0; color: #475569; font-size: 22rpx; font-weight: 600;
  padding: 6rpx 16rpx; border-radius: 12rpx;
}

.mark-btn {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 8rpx 20rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 700;
  border: 1rpx solid var(--amber-border);
  background: var(--amber-soft); color: var(--amber);
}
.mark-btn.active {
  background: var(--amber); color: #fff; border-color: var(--amber);
}

.rule-tip {
  background: var(--emerald-soft); border: 1rpx solid var(--emerald-border);
  color: #065F46; font-size: 22rpx; padding: 14rpx 22rpx;
  border-radius: 22rpx; font-weight: 500;
}

.stem-card {
  background: #fff; border-radius: 32rpx; padding: 30rpx;
  border: 1rpx solid #F1F5F9; font-size: 29rpx; line-height: 1.72;
  color: #1E293B; font-weight: 500;
}

.opt-list { display: flex; flex-direction: column; gap: 18rpx; }

.opt-item {
  background: #fff; border: 3rpx solid #E2E8F0; border-radius: 30rpx;
  padding: 24rpx 26rpx; display: flex; align-items: flex-start; gap: 22rpx;
  transition: all 0.14s;
}
.opt-item.selected {
  background: #EEF2FF; border-color: var(--primary);
  box-shadow: 0 6rpx 20rpx rgba(79, 70, 229, 0.09);
}
.opt-item.locked { pointer-events: none; }
.opt-item.correct {
  background: var(--emerald-soft); border-color: var(--emerald);
  box-shadow: none;
}
.opt-item.wrong {
  background: var(--rose-soft); border-color: var(--rose);
  box-shadow: none;
}

.opt-box {
  width: 52rpx; height: 52rpx;
  background: #F1F5F9; border: 2rpx solid #CBD5E1; color: #475569;
  font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.opt-box.circle { border-radius: 50%; }
.opt-box.square { border-radius: 16rpx; }
.opt-item.selected .opt-box { background: var(--primary); border-color: var(--primary); color: #fff; }
.opt-item.correct .opt-box { background: var(--emerald); border-color: var(--emerald); color: #fff; }
.opt-item.wrong .opt-box { background: var(--rose); border-color: var(--rose); color: #fff; }

.opt-txt { flex: 1; font-size: 27rpx; color: #334155; line-height: 1.5; padding-top: 4rpx; }
.opt-item.selected .opt-txt { color: #1E1B4B; font-weight: 600; }
.opt-item.correct .opt-txt { color: #065F46; font-weight: 600; }
.opt-item.wrong .opt-txt { color: #9F1239; font-weight: 600; }

/* 单题反馈 */
.feedback-card {
  background: #fff; border-radius: 32rpx; padding: 30rpx;
  border: 2rpx solid #E2E8F0;
}
.feedback-card.correct { border-color: var(--emerald-border); background: #F0FDF4; }
.feedback-card.partial { border-color: var(--amber-border); background: var(--amber-soft); }
.feedback-card.wrong { border-color: var(--rose-border); background: #FFF1F2; }
.feedback-card.empty { border-color: #E2E8F0; }

.feedback-head {
  display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 18rpx;
}
.feedback-label {
  font-size: 32rpx; font-weight: 800; color: #0F172A;
}
.feedback-card.correct .feedback-label { color: var(--emerald); }
.feedback-card.partial .feedback-label { color: var(--amber); }
.feedback-card.wrong .feedback-label { color: var(--rose); }
.feedback-answer {
  font-size: 26rpx; font-weight: 700; color: #334155;
}

.analysis-box { font-size: 24rpx; line-height: 1.6; color: #475569; }
.analysis-label { font-weight: 700; color: #1E293B; }
.analysis-text { margin-top: 8rpx; display: block; }
.law-box {
  background: var(--primary-soft); border: 1rpx solid var(--primary-border);
  border-radius: 20rpx; padding: 16rpx 20rpx;
  font-size: 23rpx; color: #1E1B4B; margin-top: 20rpx; line-height: 1.45;
}
.law-label { font-weight: 700; }

/* 底部操作栏 */
.q-footer {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(10px);
  border-top: 1rpx solid #E2E8F0;
  padding: 20rpx 24rpx 48rpx; display: flex; gap: 14rpx; z-index: 30;
}

.f-btn {
  height: 76rpx; padding: 0 22rpx; border-radius: 22rpx;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.f-prev { background: #F1F5F9; color: #475569; }
.f-sheet { background: var(--primary-soft); color: var(--primary); }
.f-sub { background: var(--rose-soft); color: var(--rose); border: 1rpx solid var(--rose-border); }
.f-next { flex: 1; background: var(--primary); color: #fff; }
.f-next.disabled { opacity: 0.45; }

/* 加载态 */
.loading-page {
  height: 100vh; display: flex; align-items: center; justify-content: center;
  background: var(--screen-bg);
}
.loading-text { font-size: 28rpx; color: #94A3B8; }
