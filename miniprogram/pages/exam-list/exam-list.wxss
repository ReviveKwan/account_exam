.page {
  min-height: 100vh;
  background: var(--screen-bg);
  display: flex;
  flex-direction: column;
}

.list-hero {
  background: linear-gradient(180deg, #3730A3 0%, #4F46E5 100%);
  padding-bottom: 36rpx;
  border-radius: 0 0 52rpx 52rpx;
  color: #fff;
}

.status-bar-placeholder {
  height: 88rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.nav-capsule {
  width: 160rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-evenly;
}

.cap-dots { display: flex; align-items: center; gap: 5rpx; }
.cap-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #fff; opacity: 0.9; }
.cap-dot.big { width: 9rpx; height: 9rpx; opacity: 1; }
.cap-divider { width: 2rpx; height: 28rpx; background: rgba(255, 255, 255, 0.24); }
.cap-circle { width: 28rpx; height: 28rpx; border-radius: 50%; border: 3rpx solid #fff; display: flex; align-items: center; justify-content: center; }
.cap-inner { width: 9rpx; height: 9rpx; border-radius: 50%; background: #fff; }

.user-strip {
  padding: 8rpx 32rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
}

.user-info { flex: 1; }

.user-name-row { display: flex; align-items: center; gap: 12rpx; }
.user-name { font-size: 30rpx; font-weight: 700; }
.streak-pill {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.22);
  color: #FDE68A;
  font-weight: 600;
}

.countdown { font-size: 22rpx; color: rgba(224, 231, 255, 0.82); margin-top: 4rpx; }
.countdown-num { color: #fff; font-weight: 700; }

.dash-metrics {
  margin: 24rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 32rpx;
  padding: 20rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.dm-item.mid {
  border-left: 1rpx solid rgba(255, 255, 255, 0.16);
  border-right: 1rpx solid rgba(255, 255, 255, 0.16);
}

.dm-val { font-size: 32rpx; font-weight: 800; }
.dm-suffix { font-size: 22rpx; font-weight: 400; opacity: 0.8; }
.dm-lbl { font-size: 20rpx; color: rgba(224, 231, 255, 0.82); margin-top: 2rpx; display: block; }
.dm-val.emerald { color: #6EE7B7; }

.scroll-area {
  flex: 1;
  height: 1px;
  width: 100%;
  box-sizing: border-box;
}

.scroll-inner {
  padding: 24rpx 32rpx 160rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.mode-switch {
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx;
  border: 1rpx solid #E2E8F0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.mode-btn {
  height: 64rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: transparent;
  color: #64748B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-btn.active {
  background: var(--primary);
  color: #fff;
}

.resume-bar {
  background: linear-gradient(90deg, #EEF2FF 0%, #FFFFFF 60%, #EEF2FF 100%);
  border: 1rpx solid var(--primary-border);
  border-radius: 32rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.resume-info { flex: 1; }
.resume-title { font-size: 26rpx; font-weight: 700; color: #1E293B; display: flex; align-items: center; }
.resume-tag {
  font-size: 20rpx;
  font-weight: 800;
  background: var(--primary);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-right: 10rpx;
}
.resume-meta { font-size: 22rpx; color: #64748B; margin-top: 6rpx; }
.resume-go {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 4rpx 0;
}

.filter-tags { display: flex; gap: 12rpx; }
.filter-tag {
  background: #fff;
  color: #64748B;
  border: 1rpx solid #E2E8F0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.filter-tag.active {
  background: #0F172A;
  color: #fff;
  font-weight: 700;
  border-color: #0F172A;
}
.filter-source { font-size: 22rpx; color: #94A3B8; }

.ch-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 26rpx;
  border: 1rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.025);
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.ch-bar { width: 8rpx; height: 92rpx; border-radius: 8rpx; flex-shrink: 0; }
.ch-body { flex: 1; min-width: 0; }
.ch-header { display: flex; align-items: center; gap: 12rpx; }
.ch-code {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}
.ch-title { font-size: 28rpx; font-weight: 700; color: #0F172A; }
.ch-meta { font-size: 22rpx; color: #64748B; margin-top: 8rpx; }
.ch-badges { display: flex; gap: 12rpx; margin-top: 14rpx; flex-wrap: wrap; }
.ch-arrow {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 32rpx;
  flex-shrink: 0;
}
