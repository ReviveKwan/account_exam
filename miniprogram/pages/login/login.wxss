.login-page {
  min-height: 100vh;
  background: var(--screen-bg);
  display: flex;
  flex-direction: column;
}

.hero {
  position: relative;
  padding-bottom: 108rpx;
  border-radius: 0 0 72rpx 72rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, #312E81 0%, #4338CA 55%, #4F46E5 100%);
  box-shadow: 0 24rpx 60rpx rgba(67, 56, 202, 0.22);
}

.hero-content {
  position: relative;
  padding-top: 120rpx;
  text-align: center;
  color: #fff;
}

.logo-box {
  width: 144rpx;
  height: 144rpx;
  border-radius: 44rpx;
  background: #fff;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 52rpx rgba(15, 23, 42, 0.24);
}

.logo-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #4F46E5, #3730A3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 52rpx;
  color: #fff;
}

.brand-pill {
  display: inline-flex;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  color: #E0E7FF;
  margin-bottom: 16rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: rgba(224, 231, 255, 0.86);
  margin-top: 8rpx;
}

.card-area {
  flex: 1;
  padding: 0 40rpx 56rpx;
  margin-top: -64rpx;
  position: relative;
  z-index: 20;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feature-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  border: 1rpx solid #F1F5F9;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.05);
}

.feat-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #94A3B8;
  margin-bottom: 24rpx;
}

.feat-item {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.feat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.feat-icon.indigo {
  background: var(--primary-soft);
  color: var(--primary);
}

.feat-icon.emerald {
  background: var(--emerald-soft);
  color: var(--emerald);
}

.feat-t {
  font-size: 27rpx;
  font-weight: 700;
  color: #1E293B;
}

.feat-d {
  font-size: 23rpx;
  color: #64748B;
  margin-top: 4rpx;
  line-height: 1.45;
}

.divider {
  height: 1rpx;
  background: #F1F5F9;
  margin: 24rpx 0;
}

.mini-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.mini-m {
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.mini-m-val {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
}

.mini-m-lbl {
  display: block;
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.btn-area {
  margin-top: 40rpx;
}

.btn-wx {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  border: none;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(79, 70, 229, 0.3);
}

.btn-guest {
  width: 100%;
  height: 84rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E2E8F0;
  background: #fff;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.agree-check {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.agree-check.checked {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.agree-text {
  font-size: 22rpx;
  color: #94A3B8;
}

.link {
  color: var(--primary);
  font-weight: 600;
}
