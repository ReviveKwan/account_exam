/* V2.0 全局样式 - Design Tokens */
page, view, scroll-view, text, button, image {
  box-sizing: border-box;
}

page {
  --primary: #4F46E5;
  --primary-dark: #3730A3;
  --primary-deep: #312E81;
  --primary-soft: #EEF2FF;
  --primary-border: #C7D2FE;
  --emerald: #059669;
  --emerald-soft: #ECFDF5;
  --emerald-border: #A7F3D0;
  --amber: #D97706;
  --amber-soft: #FFFBEB;
  --amber-border: #FDE68A;
  --rose: #E11D48;
  --rose-soft: #FFF1F2;
  --rose-border: #FECDD3;
  --screen-bg: #F5F6FA;
  --ink: #0F172A;
  --ink-secondary: #475569;
  --ink-muted: #94A3B8;
  --line: #E2E8F0;

  background: var(--screen-bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 28rpx;
}

/* 通用样式类 */
.tabular { font-variant-numeric: tabular-nums; }

.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 26rpx;
  border: 1rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  border: none;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
}

.pill {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.pill.pass { background: var(--emerald-soft); color: var(--emerald); }
.pill.wrong { background: var(--rose-soft); color: var(--rose); }
.pill.hot { background: var(--amber-soft); color: var(--amber); }
.pill.new { background: var(--primary-soft); color: var(--primary); }
