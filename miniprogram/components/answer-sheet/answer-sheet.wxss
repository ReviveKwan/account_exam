.backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  z-index: 45;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.drawer {
  background: #fff;
  border-radius: 52rpx 52rpx 0 0;
  padding: 24rpx 32rpx 56rpx;
  max-height: 78%;
  display: flex;
  flex-direction: column;
}

.grab {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E2E8F0;
  margin: 0 auto 20rpx;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.drawer-title { font-size: 32rpx; font-weight: 800; }
.drawer-meta { font-size: 23rpx; color: #64748B; margin-top: 4rpx; }
.meta-done { color: var(--primary); font-weight: 700; }
.meta-skip { font-weight: 700; }
.meta-mark { color: var(--amber); font-weight: 700; }

.close-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F1F5F9;
  display: flex; align-items: center; justify-content: center;
  color: #64748B; font-size: 24rpx;
}

.legend-row {
  display: flex; gap: 28rpx; font-size: 22rpx; color: #64748B;
  padding: 20rpx 0;
}
.legend-item { display: flex; align-items: center; }
.leg-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 8rpx; }
.leg-dot.done { background: var(--primary); }
.leg-dot.unanswered { border: 2rpx solid #CBD5E1; background: #fff; }
.leg-dot.marked { background: #FEF3C7; border: 3rpx solid #F59E0B; }
.leg-dot.current { background: #E0E7FF; border: 4rpx solid var(--primary); }

.sheet-scroll {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  max-height: 600rpx;
}

.section {}
.section-header { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.section-title { font-size: 24rpx; font-weight: 700; color: #334155; }

.num-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 18rpx;
}

.num-dot {
  height: 70rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  color: #475569;
}

.num-dot.done {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.num-dot.mark {
  background: var(--amber-soft);
  border: 4rpx solid #F59E0B;
  color: #B45309;
}

.num-dot.cur {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 8rpx var(--primary);
}

.sheet-footer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding-top: 28rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #F1F5F9;
}

.sheet-btn {
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.sheet-btn.continue { background: #F1F5F9; color: #334155; }
.sheet-btn.submit { background: var(--rose); color: #fff; }
